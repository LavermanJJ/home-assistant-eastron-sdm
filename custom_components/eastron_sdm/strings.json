{
  "config": {
    "step": {
      "user": {
        "title": "Eastron SDM",
        "description": "How is this meter reached?",
        "menu_options": {
          "serial": "RS485 serial port",
          "tcp": "TCP (gateway or Modbus TCP meter)"
        }
      },
      "serial": {
        "title": "Serial connection",
        "description": "Every meter on one RS485 bus must share the same baud rate, parity and stop bits. Only the unit ID differs between them.",
        "data": {
          "device": "Serial port",
          "baudrate": "Baud rate",
          "parity": "Parity",
          "stopbits": "Stop bits",
          "unit_id": "Unit ID"
        },
        "data_description": {
          "device": "The USB-RS485 converter, for example /dev/ttyUSB0.",
          "unit_id": "The meter's Modbus address, 1 to 247. Shown on the meter under the Modbus settings menu."
        }
      },
      "tcp": {
        "title": "TCP connection",
        "data": {
          "host": "Host",
          "port": "Port",
          "framer": "Framing",
          "unit_id": "Unit ID"
        },
        "data_description": {
          "framer": "Use RTU over TCP for a serial gateway such as ser2net or a Waveshare adapter, and Modbus TCP for a meter that speaks it natively.",
          "unit_id": "The meter's Modbus address, 1 to 247."
        }
      },
      "model": {
        "title": "Which meter is this?",
        "description": "This meter does not report a model code, which is normal for the SDM120CT and SDM230. Choose the model so the right register map is used.",
        "data": {
          "model": "Model"
        }
      },
      "model_unknown_code": {
        "title": "Which meter is this?",
        "description": "The meter reported model code {meter_code}, which this integration does not recognise. Choose the model so the right register map is used.",
        "data": {
          "model": "Model"
        }
      },
      "model_provisional_code": {
        "title": "Which meter is this?",
        "description": "The meter reported model code {meter_code}. No manual documents that code, but it has been reported before from a {detected}, which is preselected. Confirm it if that is what you wired, or choose the right model — the register map depends on it.",
        "data": {
          "model": "Model"
        }
      },
      "model_mismatch": {
        "title": "Which meter is this?",
        "description": "This entry is set to {configured}, but the meter reports code {meter_code} — the code for {detected}. The two have different register maps, so only one of them reads this meter correctly. {detected} is preselected; keep {configured} if you know the reported code is wrong.",
        "data": {
          "model": "Model"
        }
      }
    },
    "error": {
      "cannot_connect": "No answer from that unit ID. Check the wiring, the A/B polarity, the baud rate and the meter's own Modbus address.",
      "invalid_link": "Those connection details are incomplete.",
      "bus_settings_conflict": "That port is already in use with different line settings. Every meter on one RS485 bus has to share a baud rate, parity and stop bits."
    },
    "abort": {
      "already_configured": "This meter is already set up.",
      "different_meter": "That is a different meter from the one this entry was created for.",
      "reconfigure_successful": "Meter reconfigured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling",
        "data": {
          "scan_interval": "Scan interval"
        },
        "data_description": {
          "scan_interval": "How often to read this meter. Meters sharing a port queue behind each other on one connection, so a short interval across many meters can saturate the bus."
        }
      }
    }
  },
  "selector": {
    "framer": {
      "options": {
        "socket": "Modbus TCP",
        "rtu": "RTU over TCP"
      }
    }
  },
  "exceptions": {
    "invalid_entry": {
      "message": "The stored connection details are incomplete."
    },
    "bus_settings_conflict": {
      "message": "Cannot open the bus: {error}"
    },
    "poll_failed": {
      "message": "Error reading the meter: {error}"
    }
  },
  "issues": {
    "model_mismatch": {
      "title": "{name} may be the wrong model",
      "description": "{name} is set up as {configured}, but the meter reports code {meter_code} — the code for {detected}. The two models have different register maps, so every value is read from the wrong address, and a wrong address decodes into a plausible number rather than into an error.\n\nTo fix it, reconfigure this meter: Settings → Devices & services → Eastron SDM → the meter's ⋮ menu → Reconfigure. The flow offers {detected} for you to confirm. If you know {configured} is right and the reported code is not, keep {configured} there, and this can be ignored."
    }
  },
